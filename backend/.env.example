# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME="Appointment API"
APP_ENV=local
APP_KEY=
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost/appointment-platform
FRONTEND_URL=http://localhost/appointment-platform
PUBLIC_APP_URL=http://localhost/appointment-platform
APP_TIMEZONE=Europe/Budapest
APP_LOCALE=hu
APP_FALLBACK_LOCALE=hu
APP_FAKER_LOCALE=hu_HU
APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

# Production minimum:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://example.com
# FRONTEND_URL=https://example.com
# PUBLIC_APP_URL=https://example.com

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_CHANNEL=stack
LOG_LEVEL=debug
# Recommended in production: LOG_LEVEL=warning

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# The root/empty-password values match a default local XAMPP installation.
# In production, use a dedicated database user with the minimum required rights.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=appointment_platform
DB_USERNAME=root
DB_PASSWORD=

# -----------------------------------------------------------------------------
# Runtime stores and queue
# -----------------------------------------------------------------------------
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=database

# Queue e-mail delivery: php artisan queue:work
# Scheduled reminders: php artisan schedule:work

# -----------------------------------------------------------------------------
# API and browser origins
# -----------------------------------------------------------------------------
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1
SANCTUM_TOKEN_PREFIX=
CORS_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1

# -----------------------------------------------------------------------------
# E-mail
# -----------------------------------------------------------------------------
# Safe local default: messages are written to the Laravel log.
MAIL_MAILER=log
MAIL_SCHEME=
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@example.test"
MAIL_FROM_NAME="${APP_NAME}"

# SMTP example for production:
# MAIL_MAILER=smtp
# MAIL_SCHEME=tls
# MAIL_HOST=smtp.example.com
# MAIL_PORT=587
# MAIL_USERNAME=mailer@example.com
# MAIL_PASSWORD=USE_A_SEPARATE_APP_PASSWORD

# -----------------------------------------------------------------------------
# Admin/owner security
# -----------------------------------------------------------------------------
ADMIN_IDLE_TIMEOUT_MINUTES=4320
ADMIN_TOKEN_LIFETIME_MINUTES=43200
ADMIN_VERIFICATION_CODE_MINUTES=15
ADMIN_VERIFICATION_MAX_ATTEMPTS=5
ADMIN_VERIFICATION_ACTIVE_CODES=3
ADMIN_VERIFICATION_ATTEMPT_GRACE_MINUTES=5

# Required by the first migrate --seed run. It becomes the business contact
# address and the primary recipient of administrator booking notifications.
BUSINESS_SEED_EMAIL=

# Used only by the local/testing seeder. Production owner command:
# php artisan app:create-owner --business=default
ADMIN_SEED_EMAIL=admin@example.test
ADMIN_SEED_PASSWORD=

# -----------------------------------------------------------------------------
# Customer account security
# -----------------------------------------------------------------------------
CUSTOMER_TOKEN_LIFETIME_MINUTES=10080
CUSTOMER_VERIFICATION_CODE_MINUTES=15
CUSTOMER_VERIFICATION_MAX_ATTEMPTS=5
CUSTOMER_VERIFICATION_ACTIVE_CODES=3
CUSTOMER_VERIFICATION_ATTEMPT_GRACE_MINUTES=5

# -----------------------------------------------------------------------------
# Automated backup (portable per installation)
# -----------------------------------------------------------------------------
# Enable only after BACKUP_PATH and the binaries were verified on the target host.
BACKUP_ENABLED=false
# Safe default is private Laravel storage. On shared hosting prefer a directory
# outside the public document root, e.g. /home/account/backups/example.com
BACKUP_PATH=
BACKUP_RETENTION_DAYS=14
BACKUP_INCLUDE_MEDIA=true
BACKUP_MYSQLDUMP_BINARY=mysqldump
BACKUP_GZIP_BINARY=gzip
BACKUP_TIMEOUT_SECONDS=300

# Csak dedikált demo példányon legyen true. Valódi ügyfél production környezetében maradjon false.
DEMO_DATA_ALLOWED=false
